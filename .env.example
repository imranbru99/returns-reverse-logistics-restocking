# =============================================================================
# Returns & Reverse Logistics Platform — Environment Configuration
# Author: Imran Ahmed <me@imrandev.bd> — https://imrandev.bd
# Copy to .env and adjust for local Docker (`make install`) or production.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Returns Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Primary locale (shipped: en, bn). See APP_AVAILABLE_LOCALES.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_AVAILABLE_LOCALES=en,bn

# Default commercial currency code (ISO 4217). Tenant may override.
APP_CURRENCY=USD
APP_CURRENCY_DISPLAY=symbol

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

APP_TIMEZONE=UTC

# Docker host port for nginx (see docker-compose.yml).
APP_PORT=8080

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Demo mode
# -----------------------------------------------------------------------------
# When true: sandboxed outbound integrations, demo login shortcuts, nightly reset.
DEMO_MODE=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL 8 in Docker; SQLite for local/CI without Docker)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=returns
DB_USERNAME=returns
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_URL=

# SQLite (uncomment for host-native dev or matches phpunit.xml / CI)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Docker port forwards (host machine)
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Session, cache, queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3

QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=returns_cache_

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# -----------------------------------------------------------------------------
# Mail (Mailpit in Docker)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN="${APP_NAME}"
MAIL_FROM_ADDRESS="noreply@returns.test"
MAIL_FROM_NAME="${APP_NAME}"

FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025

# -----------------------------------------------------------------------------
# AWS / S3 (optional media backups)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Laravel Scout (database driver default; Meilisearch-ready)
# -----------------------------------------------------------------------------
SCOUT_DRIVER=database
SCOUT_PREFIX=returns_
SCOUT_QUEUE=false

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# -----------------------------------------------------------------------------
# Laravel Horizon (optional — enable docker profile `horizon`)
# -----------------------------------------------------------------------------
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=returns_horizon:

# -----------------------------------------------------------------------------
# Laravel Reverb (WebSockets / broadcasting)
# -----------------------------------------------------------------------------
REVERB_APP_ID=returns
REVERB_APP_KEY=returns-key
REVERB_APP_SECRET=returns-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# Laravel Sanctum (API / SPA tokens)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
SANCTUM_TOKEN_PREFIX=

# -----------------------------------------------------------------------------
# Social login (module-gated; credentials optional until module enabled)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT=common

# -----------------------------------------------------------------------------
# Payment gateways (sandbox flags also in config/returns.php)
# -----------------------------------------------------------------------------
PAYMENTS_SANDBOX=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX=true

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Carrier / SMS sandboxes
CARRIERS_SANDBOX=true
SMS_SANDBOX=true

# -----------------------------------------------------------------------------
# Document numbering (defaults; tenants override via settings)
# -----------------------------------------------------------------------------
RETURNS_RMA_PREFIX=RMA
RETURNS_RMA_PADDING=6
RETURNS_RMA_RESET=yearly
RETURNS_INSPECTION_PREFIX=INS
RETURNS_INSPECTION_PADDING=6
RETURNS_SHIPMENT_PREFIX=SHP
RETURNS_SHIPMENT_PADDING=6
RETURNS_INVOICE_PREFIX=INV
RETURNS_INVOICE_PADDING=6

# -----------------------------------------------------------------------------
# imrandevbd/drutogoti — performance telemetry
# -----------------------------------------------------------------------------
DRUTOGOTI_ENABLED=false
DRUTOGOTI_STORAGE_DRIVER=queue
DRUTOGOTI_QUEUE_CONNECTION=redis
DRUTOGOTI_QUEUE_NAME=default
DRUTOGOTI_WATCHER_QUERIES_ENABLED=true
DRUTOGOTI_SLOW_THRESHOLD_MS=100
DRUTOGOTI_N_PLUS_ONE_THRESHOLD=3
DRUTOGOTI_WATCHER_CACHE_ENABLED=true
DRUTOGOTI_WATCHER_COOKIES_ENABLED=true
DRUTOGOTI_WATCHER_IMAGES_ENABLED=true
DRUTOGOTI_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# imrandevbd/laravel-ai-hub — all AI features
# -----------------------------------------------------------------------------
AI_HUB_PROVIDER=openai
AI_HUB_FAILOVER=true
AI_HUB_TIMEOUT=180
AI_HUB_UI=true
AI_HUB_PATH=ai-hub
AI_HUB_MIDDLEWARE=
AI_HUB_AUTHORIZE=true
AI_HUB_ROLES=
AI_HUB_EMAILS=
AI_HUB_SETTINGS_DB=true

AI_HUB_OPENAI_MODEL=gpt-4o
AI_HUB_GEMINI_MODEL=gemini-2.0-flash
AI_HUB_CLAUDE_MODEL=claude-3-5-sonnet-latest
AI_HUB_OLLAMA_MODEL=llama3.3
AI_HUB_OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# imrandevbd/laravel-ai-catalog — product import & enrichment
# -----------------------------------------------------------------------------
AI_CATALOG_PROVIDER=
AI_CATALOG_MODEL=
AI_CATALOG_VISION_MODEL=
AI_CATALOG_EMBED_MODEL=
AI_CATALOG_PRODUCT_MODEL=App\Models\Product
AI_CATALOG_PRODUCT_TABLE=products
AI_CATALOG_CATEGORY_MODEL=App\Models\Category
AI_CATALOG_ON_APPROVE=update_or_create

# -----------------------------------------------------------------------------
# imrandevbd/laravel-attendance-hub — warehouse attendance devices
# -----------------------------------------------------------------------------
ATTENDANCE_DEFAULT_PROVIDER=zkteco
ATTENDANCE_TIMEZONE="${APP_TIMEZONE}"
ATTENDANCE_DEVICE_TIMEZONE=UTC
ATTENDANCE_ADMS_ENABLED=true
ATTENDANCE_ADMS_INTERVAL=30
ATTENDANCE_ADMS_ERROR_DELAY=60
ATTENDANCE_BRIDGE_TOKEN=
ATTENDANCE_HUB_ENCRYPT_DEVICE_SECRETS=true

# -----------------------------------------------------------------------------
# imrandevbd/laravel-unicode-pdf — multilingual PDFs
# -----------------------------------------------------------------------------
UNICODE_PDF_ENGINE=native
UNICODE_PDF_DEFAULT_FONT="Noto Sans"
UNICODE_PDF_CUSTOM_FONTS=storage/fonts

# -----------------------------------------------------------------------------
# imrandevbd/laravel-universal-slug — unicode slugs (config file for mode)
# -----------------------------------------------------------------------------
# Uses config/universal-slug.php; no required env vars for defaults.

# -----------------------------------------------------------------------------
# Laravel Admin Panel (executive dashboards — config/admin-panel.php)
# -----------------------------------------------------------------------------
ADMIN_PANEL_DEFAULT_THEME=default

# -----------------------------------------------------------------------------
# Vite frontend
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# PHPUnit / Pest (overridden in phpunit.xml for CI)
# -----------------------------------------------------------------------------
# APP_ENV=testing
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:
